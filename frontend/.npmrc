# HMS Kurdistan frontend (BUILD-PROMPT.md §4.1, §4.3).
# pnpm 11 and later read only registry and auth keys from this file; the same policy is set for pnpm
# in pnpm-workspace.yaml. These lines keep npm-compatible tools on the same policy.
save-exact=true
engine-strict=true
strict-peer-dependencies=true

# Workspace packages use the private @hms scope and are always linked with "workspace:*". Pointing the
# scope at a reserved, unresolvable host (RFC 2606) makes an accidental registry lookup for @hms/* fail
# instead of fetching a look-alike package from the public registry (dependency confusion).
@hms:registry=https://registry.invalid/
