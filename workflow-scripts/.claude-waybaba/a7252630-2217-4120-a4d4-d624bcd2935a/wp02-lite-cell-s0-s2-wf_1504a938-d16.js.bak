export const meta = {
  name: 'wp02-lite-cell-s0-s2',
  description: 'WP-0.2 slices S0 (merge WP-0.1, programme entries, clear the prototype), S1 (pins, image lock, registry, keys, signed mirror) and S2 (k3d substrate with fixed node addresses and the full-restart test R1), each reviewed and committed',
  phases: [
    { title: 'S0', detail: 'merge wp/0.1 into wp/0.2, programme entries, clear the prototype' },
    { title: 'S1', detail: 'cell.yaml pins, cell lint, keys, registry, mirror/sign/verify' },
    { title: 'S2', detail: 'substrate with fixed addresses, stop/start/status, R1' },
    { title: 'Checkpoint', detail: 'fast tier and commit per slice' },
  ],
}

const WT = 'C:\\Users\\Surface\\.t3\\worktrees\\hospitalmanagementsystem\\wp02'
const MAIN = 'C:\\Users\\Surface\\.t3\\projects\\hospitalmanagementsystem'
const PLAN = 'C:\\Users\\Surface\\AppData\\Local\\Temp\\hms-wp02\\plan.md'

const COMMON = `Context: the HMS Kurdistan hospital-system build (a hospital system for private hospitals in the Kurdistan Region of Iraq). Work package WP-0.2 "Environments": the local dev cell. BUILD-PROMPT.md is the read-only plan of record (2951 lines; read with Grep and line-ranged Read: §3 rules, §4.1 versions and cell components, §4.3 scorecard and image signing, §5.1, §16, §18.7, §19.1, §21 row 0.2, §22). The implementation plan approved by the lead: ${PLAN} (read it in full; it explains why the earlier prototype died: WSL idle-terminated the VM, Docker restarted the k3d nodes with swapped addresses and embedded etcd lost quorum). You do the slice named below.

Workspace: the git worktree ${WT}, branch wp/0.2-environments (three earlier WP-0.2 commits: the WORM test and ADR-029 SeaweedFS; .tools is a junction to the main checkout's toolchain; eval "$(sh tools/bootstrap env)"). WP-0.1 is done on wp/0.1-programme-bootstrap at 09afa41. Never touch the main checkout ${MAIN} or the WP-0.7 worktree. WSL Ubuntu-24.04 (user surface, Docker, kubectl 1.37.1, Helm 4.3.1, k3d 5.8.3): run WSL commands with MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu-24.04 --exec bash -lc '...'; cell state lives outside the repository in HMS_CELL_HOME (default ~/.local/share/hms-cell). The WSL VM has 10 GB: never start the cell while less than 6.5 GiB is available (free -m), and other sessions may run Gradle or Playwright there. C: has about 30 GiB free: stop pulling images below 15 GiB (DN-013) and report. Only the checkpoint integrator makes git commits; everyone else makes no git writes.

Rules (non-negotiable): honesty (§3.5: never claim a run that did not happen; label runs "Windows host", "WSL build host" or "lite" (cell); every number names its cell); never weaken a criterion or a safety invariant; no Bitnami images; images by digest; signing offline, no transparency-log upload, no keyless signing; the cosign private key and passphrase never enter the repository (passphrase from HMS_COSIGN_PASSWORD; generate a random one into HMS_CELL_HOME if unset, mode 600, and say so); downloads only from the publishers' official registries and release pages, each checked against its published digest or checksum; IDs only from WP-0.2's reserved ranges in docs/program/STATUS.md (DN-015…DN-019, OQ-122…OQ-139, KA-014…KA-024, HAZ-0028…HAZ-0029, ADR-030); British English; match existing code style (read tools/hmstools/cell first) and file formats exactly.`

const SLICES = {
  S0: `Slice S0, ready (runs alone). (1) In the worktree: git merge --no-ff wp/0.1-programme-bootstrap (never rebase: it would rewrite the three WP-0.2 commits, stop-and-ask item 6). Resolve every conflict by keeping both sides' content in each file's order and format (OPEN-QUESTIONS: WP-0.2's section with OQ-106 and OQ-107 after WP-0.1's entries; docs/adr/README.md; STATUS.md: take WP-0.1's file and then rewrite it for this branch; COMMANDS.md; anything else), and make cell/evidence.py use the runner's helper for the untracked-evidence rule as the plan says (keep test_evidence.py passing). This is the one step where you may run git merge and git add and git commit, in the worktree only: commit the merge after sh tools/ci/run fast --no-evidence passes, with a message in the repository's style ending with the trailer "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>". (2) Then, uncommitted for the checkpoint: the programme entries of the plan's §0, §2.4 and §9 (DN-005 update; DN-015 WSL idle termination; DN-016 inotify; DN-013 measured update; OQ-122…OQ-134 as listed; KA-014…KA-024 as listed, KA-003 updated; HAZ-0028 and HAZ-0029 with every control planned (read the hazard-log schema and the safety check); docs/program/work-packages/WP-0.2.md updated with the lite design and test names; ADR-030 (Kyverno, offline signature enforcement) as proposed in the B.1 template, keeping ADR numbering gap-free; the evidence README gets a cell/ row and the qualifier rule), and WORK-PACKAGES.md WP-0.2 in-progress. Check with sh tools/hms repo check, safety check and backlog check. (3) In WSL, clear the prototype: record docker system df and df -h /mnt/c before and after, k3d cluster delete hms-proto, and remove only the images the plan lists as unused by any pin (RustFS, versitygw, CNPG 1.27.1, Strimzi 0.48.0, Valkey 8.1) after checking each name with docker images.`,
  S1: `Slice S1, pins, image lock, registry and keys, exactly as the plan's S1 says: deploy/site-cell/cell.yaml as the single source of pins (re-check every pin with helm search repo --versions, the registries and release dates under §4.1; record chart SHA-256s and linux/amd64 manifest digests); tools/hmstools/cell/{config.py, proc.py, images.py, signing.py} with unit tests (fakes, no network); cell lint as a new fast-tier step (read tools/hmstools/ci/tiers.py and its tests; add the step and its tests); cell keys init, cell registry up, cell images mirror|sign|verify (crane and cosign run from their pinned containers; cosign signs with no transparency-log upload; verify offline). First the one-hour spike the plan describes: which signature format the pinned Kyverno verifies offline, deciding the cosign pin; record the result as an OQ. Then run in WSL: keys init, registry up, mirror, sign and verify every image of the lite profile (stop at the 15 GiB line), and write the record cell/<date>-images-<shortsha>-dirty.json only as a scratch file under /tmp (the lead makes records of record at committed SHAs). Scorecard rows and ADR-002 pins for every new component (docs/program/dependency-scorecard.md exists on this branch).`,
  S2: `Slice S2, the substrate, exactly as the plan's S2 says: deploy/site-cell/k3d/{lite,dev}.k3d.yaml with a fixed subnet so every node, the server load balancer and the registry keep their addresses; tools/hmstools/cell/{k3d.py, docker.py, kube.py} with unit tests on JSON fixtures (the prototype's IPAMConfig: null must fail the address check); cell up --only substrate (verifies the k3s image signature first, starts from the local registry's digest, k3s args as the plan's §2.1 lists, --servers-memory 3g), cell stop, cell start, cell status; tests/chaos/scenarios/cell-restart.yaml and the R1 restart test (kill all three nodes, start them in reverse order; PASS only if the API is ready within 300 s, the addresses are unchanged and etcd has all members); a detached keeper process for the cell session (the plan's §1), stopped at the end. Run in WSL when at least 6.5 GiB is available: cell up --only substrate, cell status, R1 twice, then cell stop (leave the cell stopped, not deleted). Write scratch records only under /tmp.`,
}

const LENS = {
  S0: 'merge correctness (nothing from either side lost: diff the merge against both parents for every conflicted file), ID ranges and uniqueness, ADR-030 in the B.1 template with numbering gap-free, the hazard entries valid and every control planned, DN-005 wording honest about what the lite cell can and cannot show, nothing presented as a human decision',
  S1: 'supply chain and honesty: every pin follows §4.1 with dates shown, digests real (re-check three with crane digest), no Bitnami, cosign never uploads to a transparency log or uses keyless signing, the private key and passphrase never in the repository (search the worktree and the git index), cell lint fails on each planted case, fast-tier wiring tested, the spike result recorded honestly',
  S2: 'resilience and safety of the substrate: addresses really fixed (inspect IPAMConfig), the address check fails closed on the prototype fixture, R1 measures what it claims (API readiness, addresses, etcd members) and fails when it should, the keeper process is stopped, nothing runs the cell below the memory threshold, unit tests assert real behaviour',
}

const REPORT = { type: 'object', properties: {
  files: { type: 'string' }, runs: { type: 'string', description: 'commands and results exactly as printed, with host or cell' },
  entries: { type: 'string' }, problems: { type: 'string' },
}, required: ['files', 'runs', 'entries', 'problems'] }
const ISSUES = { type: 'object', properties: { issues: { type: 'array', items: { type: 'object', properties: {
  severity: { type: 'string', enum: ['critical', 'major', 'minor'] }, file: { type: 'string' }, problem: { type: 'string' }, evidence: { type: 'string' }, fix: { type: 'string' },
}, required: ['severity', 'file', 'problem', 'evidence', 'fix'] } } }, required: ['issues'] }

async function slice(id) {
  const impl = await agent(`${COMMON}\n\nYou implement ${SLICES[id]}\n\nFinish with the slice's unit tests, sh tools/hms repo check, and sh tools/ci/run fast --no-evidence in the worktree, and report.`, { label: `${id}:impl`, phase: id, schema: REPORT, effort: 'high' })
  if (!impl) return { id, impl: null }
  const review = await agent(`${COMMON}\n\nYou are an independent reviewer of slice ${id}. Edit nothing; no git writes; in WSL you may only read (docker inspect, k3d cluster list, kubectl get with a timeout, crane digest, free, df). Lens: ${LENS[id]}. Also check the slice against the plan and re-run its unit tests.\n\nSlice: ${SLICES[id]}\nImplementer's report: ${JSON.stringify(impl)}\n\nReport only real, specific issues with evidence, ranked.`, { label: `${id}:review`, phase: id, schema: ISSUES, effort: 'high' })
  if (!review || !review.issues.length) return { id, impl, review, fix: null }
  const fix = await agent(`${COMMON}\n\nClose the issues an independent reviewer found in slice ${id}. For each: confirm, fix if real (with a test where it is behaviour), otherwise say why not. Re-run the slice's tests, any WSL run the fix affects, and sh tools/ci/run fast --no-evidence.\n\nSlice: ${SLICES[id]}\nImplementer's report: ${JSON.stringify(impl)}\nIssues: ${JSON.stringify(review.issues, null, 1)}`, { label: `${id}:fix`, phase: id, schema: REPORT, effort: 'high' })
  return { id, impl, review, fix }
}

async function checkpoint(r) {
  if (!r || !r.impl) return null
  return agent(`${COMMON}\n\nYou are the checkpoint integrator; you alone make git commits, in the worktree only. Slice ${r.id} just finished: ${JSON.stringify(r)}\n\nStage the slice's files (git status --short; nothing outside the slice; never a key, passphrase or credential: check with git diff --cached and the secret scan), run sh tools/ci/run fast --no-evidence in the worktree, and commit only if it passes, with a message in the repository's style (read git log -5 --format=%B: conventional subject such as "feat(cell): ...", a body saying what the slice adds and what ran where, "Hazards:" naming hazard entries only as the hazard log lists them, and the trailer "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"). Then update docs/program/STATUS.md on this branch (B.5 layout, at most 150 lines: slices committed, in-flight slice, next step, the WSL cell state) in a small commit "docs(programme): WP-0.2 status after ${r.id}" after the fast tier passes. Never amend, rebase, push or use --no-verify. Return the commits (SHA, subject), the fast-tier results and anything not committed with the reason.`, { label: `checkpoint:${r.id}`, phase: 'Checkpoint', effort: 'high', schema: {
    type: 'object', properties: { commits: { type: 'string' }, results: { type: 'string' }, not_committed: { type: 'string' } }, required: ['commits', 'results', 'not_committed'] } })
}

const out = []
for (const id of ['S0', 'S1', 'S2']) {
  phase(id)
  const r = await slice(id)
  const c = await checkpoint(r)
  out.push({ r, c })
  if (!r || !r.impl || !c) { log(`${id} did not finish; stopping before the next slice`); break }
}
return out
