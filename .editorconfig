# Editor settings (BUILD-PROMPT.md §6, WP-0.1). ktlint also reads this file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4

[*.gradle]
indent_size = 4

[*.{java,py}]
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,yaml,yml,md,html,css}]
indent_size = 2

# Markdown uses two trailing spaces for a hard line break.
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
