#!/usr/bin/env sh
# tools/doctor: check the build host against BUILD-PROMPT.md "Before the first session" (WP-0.1).
#   sh tools/doctor [--tier full|fast] [--json]
# Runs the stdlib-only package tools/hmstools/doctor with the system Python, so it works before the
# project venv exists. It never installs anything. Works in Linux shells and in Git Bash on Windows.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 \
    && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    exec "$candidate" -I "$ROOT/tools/hms.py" doctor "$@"
  fi
done
echo "tools/doctor: MISSING Python: no Python 3.9 or newer found as python3 or python." >&2
echo "  Ubuntu 24.04: sudo apt-get install -y python3 python3-venv python3-pip" >&2
exit 1
